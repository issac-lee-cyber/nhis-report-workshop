{
  "name": "NHIS report workshop",
  "image": "statplaybook/nhis-report-workshop:latest",
  "runArgs": ["--platform=linux/amd64"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "rstudio",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["quarto.quarto", "REditorSupport.r", "openai.chatgpt"]
    }
  }
}
